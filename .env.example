# Discord Bot Token (ได้จาก https://discord.com/developers/applications > Bot > Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Application / Client ID (ได้จาก General Information > Application ID)
CLIENT_ID=your_client_id_here

# (ไม่บังคับ) ใส่ Guild ID (Server ID) เพื่อลงทะเบียน Slash Command ทันทีโดยไม่ต้องรอ Global Cache 1 ชม.
GUILD_ID=your_guild_id_here
